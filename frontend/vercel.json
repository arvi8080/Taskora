{
  "version": 2,
  "env": {
    "CI": "false"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://taskora-d5hq.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}